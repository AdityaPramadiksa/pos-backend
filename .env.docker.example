# Salin jadi .env di VPS:  cp .env.docker.example .env
# Lalu isi APP_URL dan semua password (jangan pakai contoh ini).

APP_NAME="POS Men Gede"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos-begul.my.id

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_DATABASE=pos_mengede
DB_USERNAME=pos
DB_PASSWORD=GANTI_password_database
DB_ROOT_PASSWORD=GANTI_password_root_database

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=480
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Port aplikasi di VPS. 127.0.0.1 = hanya lewat reverse proxy (disarankan).
POS_BIND=127.0.0.1
POS_PORT=8080

# Di VPS yang port 80/443-nya dipegang Caddy proyek lain (mis. bekuin):
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# PROXY_NETWORK=bekuin_default
